
@model List<Product_Catelog.Models.Product>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Product Catalog</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #f7f8f2, #e5eddf);
            min-height: 100vh;
            font-family: Arial, sans-serif;
        }

        .header {
            background: linear-gradient(135deg, #386641, #6a994e);
            color: white;
            padding: 35px 20px;
            text-align: center;
            margin-bottom: 40px;
            box-shadow: 0 4px 15px rgba(56, 102, 65, 0.20);
        }

            .header h1 {
                font-weight: 700;
                margin-bottom: 8px;
            }

            .header p {
                margin: 0;
                opacity: 0.9;
            }

        .catalog-card {
            background: #ffffff;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 8px 25px rgba(56, 82, 52, 0.10);
        }

        .table {
            margin-bottom: 0;
            vertical-align: middle;
        }

            .table thead {
                background: #344e41;
                color: white;
            }

                .table thead th {
                    padding: 15px;
                    border: none;
                }

            .table tbody td {
                padding: 15px;
            }

            .table tbody tr {
                transition: 0.2s;
            }

                .table tbody tr:hover {
                    background-color: #edf3e7;
                    transform: scale(1.005);
                }

        .price {
            font-weight: bold;
            color: #2d7a46;
            font-size: 17px;
        }

        .details-btn {
            border-radius: 20px;
            padding: 7px 18px;
            font-weight: 500;
            transition: 0.2s;
        }

            .details-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(56, 102, 65, 0.30);
            }

        .footer {
            text-align: center;
            margin-top: 40px;
            padding: 20px;
            color: #6b796b;
        }
    </style>
</head>

<body>

    <div class="header">
        <h1>🛍️ Product Catalog</h1>
        <p>Browse our collection of products</p>
    </div>

    <div class="container">

        <div class="catalog-card">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="mb-1">Available Products</h3>
                    <p class="text-muted mb-0">
                        Explore our product collection
                    </p>
                </div>

                <span class="badge bg-primary rounded-pill px-3 py-2">
                    @Model.Count Products
                </span>
            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th class="text-center">Details</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var i in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@i.ProductName</strong>
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @i.ProductCategory
                                    </span>
                                </td>

                                <td class="price">
                                    ₹@i.ProductPrice
                                </td>

                                <td class="text-center">
                                    @Html.ActionLink(
                                        "View Details",
                                        "Details",
                                        "Products",
                                        new { id = i.ProductId },
                                        new { @class = "btn btn-primary btn-sm details-btn" }
                                    )
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <div class="footer">
        <p>© 2026 Product Catalog | MVC Application</p>
    </div>

</body>
</html>
